<section class="section container">
    <div class="orders-layout">
        <a href="/orders" class="order-detail__back-link">&larr; Volver a Mis Pedidos</a>

        <div class="category-header order-detail__header">
            <div>
                <h1 class="category-header__title">Pedido #<%= order.id %></h1>
                <p class="category-header__description">
                    Realizado el <%= new Date(order.createdAt).toLocaleDateString() %>
                </p>
            </div>
            <div class="order-detail__status-badge">
                Estado: <%= order.status %>
            </div>
        </div>

        <div class="order-detail__section">
            <h3 class="order-detail__section-title">Información de Envío</h3>
            <p class="order-detail__info-line"><strong>Recibe:</strong>
                <%= order.shippingInfo ? order.shippingInfo.firstName : order.firstName %>
                <%= order.shippingInfo ? order.shippingInfo.lastName : order.lastName %>
            </p>
            <p class="order-detail__info-line"><strong>Dirección:</strong>
                <%= order.shippingInfo ? order.shippingInfo.address : order.address %>,
                <%= order.shippingInfo ? order.shippingInfo.city : order.city %>,
                <%= order.shippingInfo ? order.shippingInfo.region : order.region %>
            </p>
            <p class="order-detail__info-line"><strong>Contacto:</strong>
                <%= order.shippingInfo ? order.shippingInfo.email : order.email %> |
                <%= order.shippingInfo ? order.shippingInfo.phone : order.phone %>
            </p>
        </div>

        <h3 style="margin-bottom: 1rem;">Artículos comprados</h3>
        <div class="order-detail__items">
            <% order.items.forEach(item => { %>
                <div class="order-detail__item">
                    <div class="order-detail__item-info">
                        <% if (item.imgSrc) { %>
                            <img src="<%= item.imgSrc %>" alt="<%= item.name %>" class="order-detail__item-image">
                        <% } else { %>
                            <div class="order-detail__item-image order-detail__item-image--placeholder"></div>
                        <% } %>
                        <div>
                            <h4 class="order-detail__item-title">
                                <%= item.name %>
                            </h4>
                            <p class="order-detail__item-qty">
                                Cantidad: <%= item.quantity %>
                            </p>
                        </div>
                    </div>
                    <div class="order-detail__item-price">
                        S/<%= ((item.price * item.quantity) / 100).toFixed(2) %>
                    </div>
                </div>
            <% }) %>
        </div>

        <div class="order-detail__summary">
            <p>Total pagado: <strong>S/<%= order.total.toFixed(2) %></strong></p>
        </div>

        <div class="order-detail__actions">
            <form action="/cart/reorder/<%= order.id %>" method="POST">
                <button type="submit" class="button button--primary order-detail__reorder-btn">
                    <img src="/images/icons/cart.svg" alt="" class="order-detail__reorder-icon">
                    Repetir este pedido
                </button>
            </form>
        </div>

    </div>
</section>