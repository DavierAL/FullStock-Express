<script type="module">
  import { mountThemeToggler } from '/js/theme-toggler.js';
  mountThemeToggler(document.querySelector('.header-actions'));
</script>

<header class="root__header">

  <div class="auth-nav">
    <div class="container auth-nav__container">
      <nav aria-label="Autenticación de usuario">
        <ul class="auth-nav__list">
          <% if (locals.user) { %>
            <li class="auth-nav__item">
              <a href="/profile" class="auth-nav__link">
                Mi Cuenta (<%= locals.user.firstName || locals.user.email %>)
              </a>
            </li>
            <li class="auth-nav__item">
              <a href="/logout" class="auth-nav__link">Cerrar sesión</a>
            </li>
            <% } else { %>
              <li class="auth-nav__item">
                <a href="/login" class="auth-nav__link">Iniciar sesión </a>
              </li>
              <li class="auth-nav__item">
                <a href="/signup" class="auth-nav__link">Crear una cuenta </a>
              </li>
              <% } %>
        </ul>
      </nav>
    </div>
  </div>
  <div class="container header-main">
    <div class="header-main__top"
      style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 0;">
      <a href="/">
        <img src="/images/fullstock-logo.svg" alt="FullStock inicio" width="128" height="32" />
      </a>

      <form action="/search" method="GET"
        style="display: flex; gap: 0.5rem; flex: 1; max-width: 400px; min-width: 250px;">
        <input type="text" name="q" class="input-field" placeholder="Buscar productos, etiquetas..." required
          style="flex: 1;">
        <button type="submit" class="button button--primary">Buscar</button>
      </form>

      <div class="header-actions">
        <a href="/wishlist" class="button button--ghost button--xl-icon header-actions__cart" aria-label="Mis Favoritos"
          style="margin-right: 0.5rem; color: red;">
          ❤️
        </a>
        <a href="/cart" class="button button--ghost button--xl-icon header-actions__cart"
          aria-label="Carrito de compras">
          <img src="/images/icons/cart.svg" alt="Carrito de compras" />
          <span class="header-actions__cart-badge">
            <%= countCartProducts %>
          </span>
        </a>
      </div>
    </div>
    <div class="separator header-main__separator"></div>
    <nav aria-label="Navegación principal" class="main-nav">
      <ul class="main-nav__list" role="menubar">
        <li class="main-nav__item" role="none">
          <a href="/category/polos" role="menuitem" class="main-nav__link">Polos</a>
        </li>
        <li class="main-nav__item" role="none">
          <a href="/category/tazas" role="menuitem" class="main-nav__link">Tazas</a>
        </li>
        <li class="main-nav__item" role="none">
          <a href="/category/stickers" role="menuitem" class="main-nav__link">Stickers</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<div id="toast-notification"
  style="position: fixed; bottom: -100px; right: 20px; background-color: #16a34a; color: white; padding: 1rem 1.5rem; border-radius: var(--radius); box-shadow: 0 4px 6px rgba(0,0,0,0.1); display: flex; align-items: center; gap: 0.5rem; transition: bottom 0.3s ease-in-out; z-index: 9999;">
  <span style="font-size: 1.2rem;">✅</span>
  <span id="toast-message" style="font-weight: 500;">Producto agregado al carrito</span>
</div>

<div id="cart-overlay"
  style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 9998; opacity: 0; pointer-events: none; transition: opacity 0.3s ease;">
</div>

<div id="cart-sidebar"
  style="position: fixed; top: 0; right: -400px; width: 100%; max-width: 400px; height: 100vh; background: var(--background); box-shadow: -4px 0 15px rgba(0,0,0,0.2); z-index: 9999; transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1); display: flex; flex-direction: column;">

  <div
    style="padding: 1.5rem; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; background: var(--muted);">
    <h2 style="margin: 0; font-size: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
      <img src="/images/icons/cart.svg" alt="" style="width: 24px;"> Mi Carrito
    </h2>
    <button id="close-cart-btn"
      style="background: none; border: none; font-size: 2rem; line-height: 1; cursor: pointer; color: var(--muted-foreground);">&times;</button>
  </div>

  <div id="cart-sidebar-content"
    style="padding: 1.5rem; flex: 1; overflow-y: auto; display: flex; flex-direction: column;">
    <p style="text-align: center; color: var(--muted-foreground);">Cargando tu carrito...</p>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // 1. Elementos del DOM
    const cartIcon = document.querySelector('a[href="/cart"]'); // Selecciona el icono del carrito del header
    const cartSidebar = document.getElementById('cart-sidebar');
    const cartOverlay = document.getElementById('cart-overlay');
    const closeCartBtn = document.getElementById('close-cart-btn');
    const cartSidebarContent = document.getElementById('cart-sidebar-content');

    // 2. Función para ABRIR el sidebar y cargar datos
    async function openCartSidebar(event) {
      if (event) event.preventDefault(); // Evita que nos lleve a /cart de golpe

      // Mostrar visualmente
      cartSidebar.style.right = '0';
      cartOverlay.style.opacity = '1';
      cartOverlay.style.pointerEvents = 'auto';
      document.body.style.overflow = 'hidden'; // Evita que la página del fondo haga scroll

      // Pedir los datos al backend (AJAX)
      try {
        const response = await fetch('/cart/mini');
        const html = await response.text();
        cartSidebarContent.innerHTML = html; // Inyectamos el HTML
      } catch (error) {
        cartSidebarContent.innerHTML = '<p style="color: red; text-align: center;">Hubo un error al cargar el carrito.</p>';
      }
    }

    // 3. Función para CERRAR el sidebar
    function closeCartSidebar() {
      cartSidebar.style.right = '-400px';
      cartOverlay.style.opacity = '0';
      cartOverlay.style.pointerEvents = 'none';
      document.body.style.overflow = ''; // Restaura el scroll
    }

    // 4. Asignamos los "escuchadores de eventos"
    if (cartIcon) cartIcon.addEventListener('click', openCartSidebar);
    if (closeCartBtn) closeCartBtn.addEventListener('click', closeCartSidebar);
    if (cartOverlay) cartOverlay.addEventListener('click', closeCartSidebar);

    // BONUS: Integración con tu script anterior del Toast
    // Si tienes el código de addToCartForms.forEach(...) aquí mismo, 
    // puedes agregar "openCartSidebar();" justo debajo de donde muestras el Toast
    // para que el carrito se abra automáticamente al agregar algo.
  });
</script>