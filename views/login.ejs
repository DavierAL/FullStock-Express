<!-- views/login.ejs -->
<script type="module" src="/js/toggle-password.js"></script>
<script type="module">
    import { setupFormValidation } from "/js/form-validation.js";
    import { loginSchema } from "/js/shared/authSchema.js";

    const formLogin = document.querySelector("[data-js='login-form']");
    setupFormValidation(formLogin, loginSchema);
</script>
<section class="section">
    <div class="container login">
        <h1 class="login__title">Inicia sesión en tu cuenta</h1>
        <!-- Mensaje de error general -->
        <% if (locals.error) { %>
            <div class="alert--error">
                <%= locals.error %>
            </div>
            <% } %>
                <!-- El formulario envía los datos vía POST a la ruta /login -->
                <form class="login__form" method="post" action="/login" data-js="login-form" novalidate>
                    <div class="input-field <%= locals.errors && errors.email ? 'input-field--error' : '' %>">
                        <label for="email">Correo electrónico</label>
                        <input id="email" name="email" autocomplete="email" required
                            value="<%= locals.values?.email || '' %>" />
                        <% if (locals.errors && errors.email) { %><span class="input-field__error">
                                <%= errors.email[0] %>
                            </span>
                            <% } %>
                    </div>

                    <div class="input-field <%= locals.errors && errors.password ? 'input-field--error' : '' %>">
                        <label for="password">Contraseña</label>
                        <input id="password" name="password" type="password" required autocomplete="current-password"
                            data-toggle-password />
                        <% if (locals.errors && errors.password) { %><span class="input-field__error">
                                <%= errors.password[0] %>
                            </span>
                            <% } %>
                    </div>

                    <button type="submit" class="button button--lg login__submit"> Iniciar sesión </button>
                </form>
    </div>
</section>