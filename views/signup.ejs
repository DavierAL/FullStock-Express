<script type="module" src="/js/toggle-password.js"></script>
<section class="section">
    <div class="container signup">
        <h1 class="signup__title">Crea una cuenta</h1>
        <% if (locals.error) { %>
            <div class="alert--error">
                <%= locals.error %>
            </div>
        <% } %>
        <form class="signup__form" method="post" action="/signup" novalidate>
            <div class="input-field <%= locals.errors && errors.email ? 'input-field--error' : '' %>">
                <label for="email">Correo electrónico</label>
                <input id="email" name="email" type="email" required autocomplete="email" value="<%= locals.values?.email || '' %>" />
                <% if (locals.errors && errors.email) { %><span class="input-field__error"><%= errors.email[0] %></span><% } %>
            </div>
            
            <div class="input-field <%= locals.errors && errors.password ? 'input-field--error' : '' %>">
                <label for="password">Contraseña</label>
                <input id="password" name="password" type="password" required data-toggle-password />
                <% if (locals.errors && errors.password) { %><span class="input-field__error"><%= errors.password[0] %></span><% } %>
            </div>
            
            <div class="input-field <%= locals.errors && errors.confirmPassword ? 'input-field--error' : '' %>">
                <label for="confirm-password">Confirma tu contraseña</label>
                <input id="confirm-password" name="confirmPassword" type="password" required data-toggle-password />
                <% if (locals.errors && errors.confirmPassword) { %><span class="input-field__error"><%= errors.confirmPassword[0] %></span><% } %>
            </div>
            
            <button type="submit" class="button button--lg signup__submit">
                Crear cuenta
            </button>
        </form>
        <div class="signup__footer">
            <span class="signup__footer_text"> ¿Ya tienes una cuenta? </span>
            <a href="/login" class="signup__footer_link"> Inicia sesión </a>
        </div>
    </div>
</section>